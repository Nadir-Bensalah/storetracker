# Google Maps SDK for Android key (Maps SDK for Android only, restricted to the
# app package + signing SHA-1). Without it, the Android map is replaced by a
# notice instead of crashing. iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Simulated network latency of the mock API, in milliseconds.
EXPO_PUBLIC_API_LATENCY_MS=600

# Probability (0 to 1) that a mock API call fails, to exercise error states.
EXPO_PUBLIC_API_ERROR_RATE=0

# Apple developer team, only to install on a physical iPhone. Simulator builds
# need nothing.
APPLE_TEAM_ID=
